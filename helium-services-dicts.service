[Unit]
Description=Publish Helium spellcheck dictionaries from system hunspell files
Documentation=https://github.com/imputnet/helium-services

[Service]
Type=oneshot
User=helium-services
Group=helium-services
EnvironmentFile=/etc/helium-services/helium-services.env
ExecStart=/usr/libexec/helium-services/refresh-dicts.sh
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/www/helium-services /var/lib/helium-services
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
UMask=0022
