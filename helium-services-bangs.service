[Unit]
Description=Refresh the Helium bangs list
Documentation=https://github.com/imputnet/helium-services
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=helium-services
Group=helium-services
EnvironmentFile=/etc/helium-services/helium-services.env
ExecStart=/usr/libexec/helium-services/refresh-bangs.sh
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/www/helium-services
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0022
