[Unit]
Description=Helium extension download proxy
Documentation=https://github.com/imputnet/helium-services
After=network-online.target
Wants=network-online.target

[Service]
User=helium-services
Group=helium-services
# Used when the env file does not set LISTEN. The binary's own default
# is 0.0.0.0:8000, which this unit must not fall through to.
Environment=LISTEN=127.0.0.1:8091
EnvironmentFile=/etc/helium-services/helium-services.env
StateDirectory=helium-services
StateDirectoryMode=0750
WorkingDirectory=/var/lib/helium-services
ExecStart=/usr/libexec/helium-services/extension-proxy
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
