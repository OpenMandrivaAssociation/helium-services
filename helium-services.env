# Public name of this host. Helium's helium.services.origin_override must
# be the origin that reaches the vhost for this name, for example
# https://services.example.com with no path on the end.
SERVICES_HOSTNAME=helium-services.invalid

# Signing key for proxied extension downloads. The package fills this in
# on first install when the value is empty. It needs 32 bytes or more.
# Clearing the value and reinstalling, or editing it here, rotates it.
HMAC_SECRET=

# URLs written into proxied responses. Keep them on SERVICES_HOSTNAME.
PROXY_BASE_URL=https://helium-services.invalid/ext/
UBO_PROXY_BASE_URL=https://helium-services.invalid/ubo/

# Local listeners. The web server proxies to these. Do not use 0.0.0.0.
# A change here has to be copied into the nginx or apache vhost.
LISTEN=127.0.0.1:8091
UBO_LISTEN=127.0.0.1:8092

# This snapshot requests uBlock Origin 1.76.4 assets. Set both of the
# following to use another assets.json. Do not combine them with
# UBO_USE_ORIGINAL_UBLOCK_ASSETS.
# UBO_USE_ORIGINAL_UBLOCK_ASSETS=
# UBO_ASSETS_JSON_URL=
# UBO_ASSETS_JSON_SHA256=

# bangs.json refresh (helium-services-bangs.timer). The package ships a
# snapshot, so /bangs.json works before the first successful refresh.
BANG_SOURCE=https://raw.githubusercontent.com/imputnet/helium-services/refs/heads/main/svc/bangs/bangs.json

# Spellcheck dictionaries are read from the myspell files in this
# directory and published as the .bdic names Helium requests.
# HUNSPELL_DIR=/usr/share/hunspell
